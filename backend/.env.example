#DJANGO
# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost
# Production uniquement (origines HTTPS du front) :
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=UTC
LOG_LEVEL=INFO

#BASE DE DONNÉES
DB_ENGINE=mssql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=1433
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_CERT=no
DB_CONN_MAX_AGE=60

#CORS (origines du front, séparées par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:5173

#JWT
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

#REDIS (broker Celery + cache)
REDIS_URL=redis://localhost:6379/0

#E-MAILS (SMTP)
EMAIL_BACKEND=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

#IA (Groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

#Limitations de débit
THROTTLE_LOGIN=10/min
THROTTLE_AI=20/min

#Adresse de l'application
APP_URL=http://localhost:8080
